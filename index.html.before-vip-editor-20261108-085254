function wavToFloat32(wav){
 const view=new DataView(wav.buffer,wav.byteOffset,wav.byteLength);
 const readText=(offset,length)=>String.fromCharCode(...new Uint8Array(wav.buffer,wav.byteOffset+offset,length));
 if(readText(0,4)!=='RIFF'||readText(8,4)!=='WAVE')
  throw new Error('Extracted audio is not a valid WAV file.');
 let offset=12,format=null,channels=0,rate=0,bits=0,dataOffset=-1,dataSize=0;
 while(offset+8<=wav.byteLength){
  const id=readText(offset,4);
  const size=view.getUint32(offset+4,true);
  const start=offset+8;
  if(start+size>wav.byteLength)throw new Error('Invalid WAV chunk size.');
  if(id==='fmt '&&size>=16){
   format=view.getUint16(start,true);
   channels=view.getUint16(start+2,true);
   rate=view.getUint32(start+4,true);
   bits=view.getUint16(start+14,true);
  }else if(id==='data'){
   dataOffset=start;
   dataSize=size;
   break;
  }
  offset=start+size+(size%2);
 }
 if(format!==1||channels!==1||rate!==16000||bits!==16||dataOffset<0||dataSize<2)
  throw new Error('Unexpected WAV format; expected 16 kHz mono PCM 16-bit.');
 const count=Math.floor(dataSize/2);
 const samples=new Float32Array(count);
 for(let i=0;i<count;i++)samples[i]=view.getInt16(dataOffset+i*2,true)/32768;
 return samples;
}

async function getAudio(){
 let audioFile=file;

 if(file.type.startsWith('video/')){
  status('Extracting audio track from video...');
  const ff=await getFFmpeg();
  const ext=(file.name.split('.').pop()||'mp4').replace(/[^a-z0-9]/gi,'')||'mp4';
  await ff.writeFile('ak-source.'+ext,await ffmpegFetchFile(file));
  const ffmpegExitCode=await ff.exec([
   '-y','-i','ak-source.'+ext,
   '-vn','-ac','1','-ar','16000',
   '-c:a','pcm_s16le','ak-audio.wav'
  ]);
  if(ffmpegExitCode!==0){
   throw new Error('Audio extraction failed. FFmpeg exit code: '+ffmpegExitCode);
  }
  const wav=await ff.readFile('ak-audio.wav');
  status('Preparing extracted audio for AI...');
  const audio=wavToFloat32(wav);
  if(!audio.length)throw new Error('Extracted audio is empty.');
  status('Audio extracted: '+Math.floor(audio.length/16000)+' seconds.');
  return audio;
 }

 status('Converting audio to 16 kHz mono...');
 const ctx=new AudioContext();
 try{
  const decoded=await ctx.decodeAudioData(await audioFile.arrayBuffer());
  const target=16000;
  const length=Math.max(1,Math.ceil(decoded.duration*target));
  const offline=new OfflineAudioContext(1,length,target);
  const src=offline.createBufferSource();
  src.buffer=decoded;
  src.connect(offline.destination);
  src.start(0);
  const rendered=await offline.startRendering();
  return rendered.getChannelData(0).slice();
 }finally{
  await ctx.close();
 }
}



function romanizeHindiRun(run){
 const consonants={
  'क':'k','ख':'kh','ग':'g','घ':'gh','ङ':'ng',
  'च':'ch','छ':'chh','ज':'j','झ':'jh','ञ':'ny',
  'ट':'t','ठ':'th','ड':'d','ढ':'dh','ण':'n',
  'त':'t','थ':'th','द':'d','ध':'dh','न':'n',
  'प':'p','फ':'ph','ब':'b','भ':'bh','म':'m',
  'य':'y','र':'r','ल':'l','व':'v','श':'sh',
  'ष':'sh','स':'s','ह':'h'
 };
 const nukta={
  'क':'q','ख':'kh','ग':'gh','ज':'z',
  'ड':'r','ढ':'rh','फ':'f','य':'y','र':'r'
 };
 const vowels={
  'अ':'a','आ':'a','इ':'i','ई':'i','उ':'u',
  'ऊ':'u','ऋ':'ri','ए':'e','ऐ':'ai','ओ':'o',
  'औ':'au','ऑ':'o'
 };
 const matras={
  'ा':'a','ि':'i','ी':'i','ु':'u','ू':'u',
  'ृ':'ri','े':'e','ै':'ai','ो':'o','ौ':'au'
 };
 let out='',lastInherent=false;

 for(let i=0;i<run.length;i++){
  let ch=run[i];

  if(consonants[ch]){
   let base=consonants[ch];
   if(run[i+1]==='़'){
    base=nukta[ch]||base;
    i++;
   }
   out+=base;
   lastInherent=false;

   if(run[i+1]==='्'){
    i++;
   }else if(matras[run[i+1]]){
    out+=matras[run[++i]];
   }else{
    out+='a';
    lastInherent=true;
   }
  }else if(vowels[ch]){
   out+=vowels[ch];
   lastInherent=false;
  }else if(ch==='ं'||ch==='ँ'){
   out+='n';
   lastInherent=false;
  }else if(ch==='ः'){
   out+='h';
   lastInherent=false;
  }else if(ch==='़'||ch==='्'||ch==='ं‍'){
   lastInherent=false;
  }else{
   out+=ch;
   lastInherent=false;
  }
 }

 if(lastInherent&&out.endsWith('a'))out=out.slice(0,-1);
 return out;
}

function romanizeHindiText(text){
 return String(text||'')
  .replace(/[\u0900-\u097F]+/g,romanizeHindiRun)
  .replace(/(^|[.!?]\s+)([a-z])/g,
   (_,prefix,letter)=>prefix+letter.toUpperCase());
}

