 }finally{
  busy=false;
  $('generate').disabled=false;
  $('translate').disabled=false;
 }
};

$('translate').onclick=async()=>{
 if(!rows.length)return alert('Generate subtitles first.');
 if(busy)return;

 busy=true;
 $('translate').disabled=true;
 $('generate').disabled=true;

 try{
  await translateRowsToHindi();
 }catch(e){
  status('Translation error ['+translationStage+']: '+errorDetails(e));
  console.error(e);
 }finally{
  busy=false;
  $('translate').disabled=false;
  $('generate').disabled=false;
 }
};

$('add').onclick=()=>{
 const t=$('video').currentTime||0;
 rows.push({start:t,end:t+3,text:'अपना सबटाइटल यहाँ लिखें'});
 render();
};
$('reset').onclick=()=>{
 $('size').value=28;$('color').value='#ffffff';
 $('background').value='transparent';$('style').value='classic';style();
};
$('srt').onclick=()=>{
 if(!rows.length)return alert('No subtitles to download.');
 const content=rows.map((r,i)=>
 `${i+1}\n${srtTime(r.start)} --> ${srtTime(r.end)}\n${r.text}\n`
 ).join('\n');
 download(new Blob([content],{type:'text/plain;charset=utf-8'}),'AK-Sub-AI.srt');
};
function download(blob,name){
 const a=document.createElement('a');
 a.href=URL.createObjectURL(blob);a.download=name;a.click();
 setTimeout(()=>URL.revokeObjectURL(a.href),3000);
}
$('export').onclick=async()=>{
 if(!file||!rows.length)return alert('Upload video and generate subtitles first.');
 if(!file.type.startsWith('video/'))return alert('MP4 export requires a video file.');
 if(busy)return;
 busy=true;$('export').disabled=true;
 try{
  status('Preparing subtitle file...');
  const srt=rows.map((r,i)=>
   `${i+1}\n${srtTime(r.start)} --> ${srtTime(r.end)}\n${r.text}\n`
  ).join('\n');
  const ff=await getFFmpeg();
  const ext=(file.name.split('.').pop()||'mp4').replace(/[^a-z0-9]/gi,'');
  await ff.writeFile('input.'+ext,await ffmpegFetchFile(file));
  await ff.writeFile('captions.srt',new TextEncoder().encode(srt));
  await ff.writeFile('NotoSansDevanagari-Regular.ttf',await ffmpegFetchFile(new URL('./assets/fonts/NotoSansDevanagari-Regular.ttf',document.baseURI).href));
  status('Burning subtitles with Noto Sans Devanagari. This may take time...');
  const size=Math.max(16,Math.min(48,Number($('size').value)||28));
  const hex=$('color').value.replace('#','').toUpperCase();
  const assColor='&H00'+hex.slice(4,6)+hex.slice(2,4)+hex.slice(0,2);
  const mode=$('style').value;
  const fontSize=mode==='reels'?Math.min(54,size+6):size;
  const outline=mode==='reels'?4:mode==='karaoke'?3:2;
  const shadow=mode==='classic'?1:0;
  const boxed=$('background').value==='black';
  const backColour=boxed?'&H00000000':'&HFF000000';
  const forceStyle=`FontName=Noto Sans Devanagari,FontSize=${fontSize},PrimaryColour=${assColor},OutlineColour=&H00000000,BackColour=${backColour},BorderStyle=${boxed?3:1},Outline=${outline},Shadow=${shadow},Alignment=2,MarginV=35,Bold=1`;
  await ff.exec([
   '-i','input.'+ext,
   '-map','0:v:0','-map','0:a?',
   '-vf',`subtitles=captions.srt:fontsdir=.:force_style='${forceStyle}'`,
   '-c:v','libx264',
   '-preset','medium',
   '-crf','18',
   '-pix_fmt','yuv420p',
   '-c:a','aac',
   '-b:a','192k',
   '-movflags','+faststart',
   'output.mp4'
  ]);
  const data=await ff.readFile('output.mp4');
  download(new Blob([data.buffer],{type:'video/mp4'}),'AK-Sub-AI.mp4');
  status('MP4 export complete!');
 }catch(e){
  status('MP4 export unavailable in this browser build: '+e.message+' Download SRT instead.');
  console.error(e);
 }finally{busy=false;$('export').disabled=false}
};
style();
</script>
</body>
</html>
