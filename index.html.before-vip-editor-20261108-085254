// AI inference moved to ai-worker.js

const $=id=>document.getElementById(id);
let file=null, videoURL=null, rows=[];
let busy=false;
let translationStage='general processing';

const aiWorker=new Worker(
 new URL('./ai-worker.js',import.meta.url),
 {type:'module'}
);
let workerSequence=0;
const workerPending=new Map();

aiWorker.onmessage=({data})=>{
 if(data.progress){
  status(data.progress);
  return;
 }
 const p=workerPending.get(data.id);
 if(!p)return;
 workerPending.delete(data.id);
 if(data.ok)p.resolve(data.result);
 else p.reject(new Error(data.error||'Background AI failed.'));
};
aiWorker.onerror=e=>{
 const error=new Error(e.message||'AI worker failed.');
 for(const p of workerPending.values())p.reject(error);
 workerPending.clear();
};
function workerRequest(type,payload={},transfer=[]){
 return new Promise((resolve,reject)=>{
  const id=++workerSequence;
  workerPending.set(id,{resolve,reject});
  try{
   aiWorker.postMessage({id,type,...payload},transfer);
  }catch(e){
   workerPending.delete(id);
   reject(e);
  }
 });
}

let ffmpegEngine=null, ffmpegFetchFile=null, ffmpegLoadPromise=null;

async function getFFmpeg(){
 if(ffmpegEngine)return ffmpegEngine;
 if(ffmpegLoadPromise)return ffmpegLoadPromise;

 ffmpegLoadPromise=(async()=>{
  const {FFmpeg}=await import('https://cdn.jsdelivr.net/npm/@ffmpeg/ffmpeg@0.12.10/dist/esm/index.js');
  const {fetchFile,toBlobURL}=await import('https://cdn.jsdelivr.net/npm/@ffmpeg/util@0.12.1/dist/esm/index.js');
  const engine=new FFmpeg();
  engine.on('log',({message})=>{if(message)status(message)});
  status('Loading browser media engine...');
  await engine.load({
   classWorkerURL:new URL('./vendor/ffmpeg/worker.js',document.baseURI).href,
   coreURL:await toBlobURL('https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/esm/ffmpeg-core.js','text/javascript'),
   wasmURL:await toBlobURL('https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/esm/ffmpeg-core.wasm','application/wasm')
  });
  ffmpegFetchFile=fetchFile;
  ffmpegEngine=engine;
  return engine;
 })();

 try{return await ffmpegLoadPromise}
 finally{ffmpegLoadPromise=null}
}
