function time(s){
 s=Math.max(0,Number(s)||0);
 return new Date(s*1000).toISOString().slice(11,19)+
 '.'+String(Math.floor(s*1000)%1000).padStart(3,'0');
}
function parse(s){
 const value=String(s).trim();
 if(!/^\d{1,}:[0-5]\d:[0-5]\d(?:\.\d{1,3})?$/.test(value))return NaN;
 const p=value.split(':').map(Number);
 return p[0]*3600+p[1]*60+p[2];
}
function srtTime(s){
 return time(s).replace('.',',');
}
function render(){
 $('count').textContent=rows.length+' lines';
 $('timeline').innerHTML='';
 rows.forEach((r,i)=>{
  const div=document.createElement('div');
  div.className='segment';
  const times=document.createElement('div');
  const start=document.createElement('input');
  start.value=time(r.start);
  start.title='Start time';
  const end=document.createElement('input');
  end.value=time(r.end);
  end.title='End time';
  start.onchange=()=>{
   const value=parse(start.value);
   if(!Number.isFinite(value)||value<0||value>=r.end){
    start.value=time(r.start);
    status('गलत शुरुआत का समय। इसे समाप्ति के समय से पहले रखें।');
    return;
   }
   r.start=value;
   updatePreview();
  };
  end.onchange=()=>{
   const value=parse(end.value);
   const duration=$('video').duration;
   if(!Number.isFinite(value)||value<=r.start||value<0||(Number.isFinite(duration)&&value>duration)){
    end.value=time(r.end);
    status('गलत समाप्ति का समय। इसे शुरुआत के बाद और वीडियो की अवधि के अंदर रखें।');
