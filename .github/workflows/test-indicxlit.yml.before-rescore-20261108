name: Test IndicXlit Hindi Model

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test-indicxlit:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout AK-Sub-AI
        uses: actions/checkout@v4

      - name: Checkout official IndicXlit source
        uses: actions/checkout@v4
        with:
          repository: AI4Bharat/IndicXlit
          ref: v1.0
          path: indicxlit-source

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.10"

      - name: Install compatible CPU dependencies
        run: |
          python -m pip install "pip<24.1" "setuptools<60" wheel
          python -m pip install numpy==1.23.5
          python -m pip install torch==1.13.1+cpu torchaudio==0.13.1+cpu --extra-index-url https://download.pytorch.org/whl/cpu
          python -m pip install Cython==0.29.36 PyYAML==6.0.1 omegaconf==2.0.6 hydra-core==1.0.7
          python -m pip install pydload tqdm ninja
          python -m pip install --no-build-isolation "git+https://github.com/facebookresearch/fairseq.git@v0.12.2"

      - name: Prepare official IndicXlit model
        run: |
          MODEL_ROOT="indicxlit-source/app/ai4bharat/transliteration/transformer/models"
          MODEL_DIR="$MODEL_ROOT/v1.0"

          mkdir -p "$MODEL_DIR"

          test -f "$MODEL_ROOT/lang_list.txt"

          curl -fL --retry 3 \
            "https://github.com/akingstar/AK-Sub-AI/releases/download/v1.0-nllb/indicxlit-en-indic-v1.0.zip" \
            -o "$RUNNER_TEMP/indicxlit-en-indic-v1.0.zip"

          unzip -q "$RUNNER_TEMP/indicxlit-en-indic-v1.0.zip" -d "$MODEL_DIR"

          test -f "$MODEL_DIR/transformer/indicxlit.pt"
          test -f "$MODEL_DIR/corpus-bin/dict.en.txt"
          echo "IndicXlit model files verified."

      - name: Test Roman Hindi to Devanagari
        env:
          PYTHONPATH: indicxlit-source/app
        run: |
          python - <<'PY'
          from ai4bharat.transliteration import XlitEngine

          print("Loading official IndicXlit Hindi model...")
          engine = XlitEngine(
              lang2use="hi",
              beam_width=4,
              rescore=False
          )

          samples = [
              "mera naam akshay hai",
              "aap kaise ho",
              "mujhe ghar jana hai",
              "kal milte hain",
              "namaste bhai",
              "hum kal milte hain",
              "aaj mausam bahut accha hai",
              "mujhe aapse baat karni hai",
              "kripya mujhe bataiye",
              "yeh mera phone hai",
              "main ghar par hoon",
              "aapka naam kya hai",
              "dhanyavaad bhai"
          ]

          print("\n===== TRANSLITERATION RESULTS =====")
          for text in samples:
              result = engine.translit_sentence(text, lang_code="hi")
              print(f"INPUT : {text}")
              print(f"OUTPUT: {result}")
              print("-" * 40)
          PY
