   }
   r.end=value;
   updatePreview();
  };
  times.append(start,end);
  const right=document.createElement('div');
  const ta=document.createElement('textarea');
  ta.value=r.text;
  ta.oninput=()=>{r.text=ta.value;updatePreview()};
