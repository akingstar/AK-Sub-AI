 status(completionMessage);
}


const TURNSTILE_SITE_KEY = '0x4AAAAAAF4SP-mfoSwBJgvu';
let akTurnstileLoadPromise=null;

function loadAkTurnstile(){
 if(window.turnstile)return Promise.resolve();
 if(akTurnstileLoadPromise)return akTurnstileLoadPromise;
 akTurnstileLoadPromise=new Promise((resolve,reject)=>{
  const script=document.createElement('script');
  script.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
  script.async=true;
  script.defer=true;
  script.onload=resolve;
  script.onerror=()=>reject(new Error('Could not load Cloudflare security check.'));
  document.head.appendChild(script);
 });
 return akTurnstileLoadPromise;
}
async function getTurnstileToken(){
 if(!TURNSTILE_SITE_KEY||TURNSTILE_SITE_KEY.startsWith('REPLACE_'))
  throw new Error('Configure the Cloudflare Turnstile site key first.');
 await loadAkTurnstile();
 return new Promise((resolve,reject)=>{
  let settled=false;
  const finish=(fn,value)=>{
   if(settled)return;
   settled=true;
   fn(value);
  };
  const box=document.createElement('div');
  box.style.cssText='position:fixed;left:-10000px;top:-10000px;width:1px;height:1px;overflow:hidden;';
  document.body.appendChild(box);
  try{
   const id=window.turnstile.render(box,{
    sitekey:TURNSTILE_SITE_KEY,
    size:'invisible',
    execution:'execute',
    action:'ak_sub_ai',
    callback:token=>finish(resolve,token),
    'error-callback':()=>finish(reject,new Error('Cloudflare security check failed.')),
    'expired-callback':()=>finish(reject,new Error('Security token expired. Please retry.'))
   });
   window.turnstile.execute(id);
  }catch(error){finish(reject,error);}
 });
}

