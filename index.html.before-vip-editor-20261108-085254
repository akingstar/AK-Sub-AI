function errorDetails(e){
 try{
  if(e instanceof Error)return e.stack||e.message||String(e);
  if(typeof e==='string')return e;
  if(typeof e==='number')return 'Numeric error '+e+' (hex 0x'+(e>>>0).toString(16)+')';
